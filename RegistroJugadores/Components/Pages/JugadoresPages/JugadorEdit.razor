@page "/Jugador/Edit/{JugadorId:int}"

@inject IJugadoresApiService jugadoresApiService
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Create</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class=" card-header text-center">
            <h5 class="card-title">Crear Jugador</h5>
        </div>
    </div>

    <div class="card-body">

        @*Nombre*@
        <div class="mb-3">
            <label class="col-form-label"><strong>Nombres</strong></label>
            <InputText class="form-control" @bind-Value="Nombre"></InputText>
        </div>

        @*Victorias*@
        <div class="mb-3">
            <label class="form-label"><strong>Email</strong></label>
            <InputText class="form-control" @bind-Value="Email"></InputText>
        </div>
        @*footer*@
    </div>

    <div class="card-footer text-center mt-2">
        <a href="/jugadores/index" class="btn btn-secondary"><span class="bi bi-arrow-left"></span>Volver</a>
        <button type="button" class="btn btn-outline-success bi bi-check-circle" @onclick="Modificar"><span class="bi bi-save>"></span>Modificar</button>

    </div>
</div>
@code {
    [Parameter]
    public int JugadorId { get; set; }
    public string Nombre { get; set; } 
    public string Email { get; set; } 

    protected override async Task OnInitializedAsync()
    {
        var jugador = await jugadoresApiService.GetJugadorAsync(JugadorId);
        Nombre = jugador.Data.Nombres;
        Email = jugador.Data.Email;

    }

    public async Task Modificar()
    {
        var modificado = await jugadoresApiService.PutJugador(JugadorId, Nombre, Email);
        if(modificado is Resource<JugadorResponse>.Success success)
        {
            NavigationManager.NavigateTo("/jugadores/index");
        }


        
    }

}
