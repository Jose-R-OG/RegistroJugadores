@page "/game/{PartidaId:int}"

@rendermode InteractiveServer
@inject IJugadoresApiService jugadoresApiService
@inject IPartidaApiService partidaApiService
@inject IMovimientosApiService movimientosApiService
@inject NavigationManager navigationManager

<PageTitle>Home</PageTitle>


<div class="container mx-auto max-w-lg p-6 bg-white rounded-lg shadow-xl text-center">

    <div class="game-container">
        <h2>Partida: #@PartidaId</h2>
        <h2 class="game-status">@GameStatus</h2>
        
            <div class="game-screen">
                <div class="game-board">
                    @for (var i = 0; i < 9; i++)
                    {
                        var cellIndex = i; // Copia local para evitar problemas con el closure en el lambda
                                           <button class="cell @GetPlayerClass(board[cellIndex])"
                                                   @onclick="() => HandleCellClick(cellIndex)"
                                                   disabled="@(board[cellIndex] != null || winner != null || esEmpate)">
                                               @board[cellIndex]?.ToString()
                                           </button>
                    }
                </div>

                <button class="btn btn-secondary mt-4" @onclick="RestartGame">
                    Reiniciar Juego
                </button>
            </div>
    </div>
</div>
@code {
    private enum PlayerType { X, O }

    private PlayerType?[] board = new PlayerType?[9];
    private PlayerType _currentPlayerType = PlayerType.X;
    private PlayerType? winner;
    private bool esEmpate;

    [Parameter]
    public int PartidaId { get; set; }
    private string Jugador1 { get; set; } = string.Empty;
    private string? Jugador2 { get; set; } = string.Empty;



    protected override async Task OnInitializedAsync()
    {
        await CargarTablero();
        winner = CheckForWinner();
        esEmpate = board.All(cell => cell != null);
        await CargarNombres();
    }

    private string GameStatus
    {
        get
        {
            if (winner != null) return $"🏆 ¡Ganador: {(winner == PlayerType.X ? Jugador1 : Jugador2 )}!";
            return esEmpate
                ? "🤝 ¡Es un empate!"
                : $"Turno de: {(_currentPlayerType == PlayerType.X ? Jugador1 : Jugador2 )}";
        }
    }


    public async Task CargarJugador2()
    {
        var partida = await partidaApiService.GetPartidaAsync(PartidaId);
    }



    public async Task CargarTablero()
    {
        var movimientos = await movimientosApiService.GetMovimientoAsync(PartidaId);
        foreach(var m in movimientos.Data)
        {
            board[(m.PosicionFila * 3) + m.PosicionColumna] = Enum.Parse<PlayerType>(m.Jugador);
            _currentPlayerType = Enum.Parse<PlayerType>(m.Jugador) == PlayerType.X ? PlayerType.O : PlayerType.X;
        }
    }


    public async Task CargarNombres()
    {
        var partida = await partidaApiService.GetPartidaAsync(PartidaId);
        Jugador1 = (await jugadoresApiService.GetJugadorAsync(partida.Data.Jugador1Id)).Data.Nombres;
        Jugador2 = (await jugadoresApiService.GetJugadorAsync(partida.Data.Jugador2Id ?? 0)).Data.Nombres;
    }

    private async Task HandleCellClick(int index)
    {
        // Ignorar si la celda está ocupada o el juego terminó
        if (board[index] != null || winner != null || esEmpate)
        {
            return;
        }

        board[index] = _currentPlayerType;
        await movimientosApiService.PostMovimiento(PartidaId, _currentPlayerType.ToString(), index / 3, index % 3);

        winner = CheckForWinner();
        if (winner != null)
        {
            return; // El juego termina
        }
        esEmpate = board.All(cell => cell != null);
        if (esEmpate)
        {
            return; // El juego termina
        }
        

        // Cambiar turno
        _currentPlayerType = (_currentPlayerType == PlayerType.X)
            ? PlayerType.O
            : PlayerType.X;
    }



    private PlayerType? CheckForWinner()
    {
        var winningLines = new[]
        {
             new[] {0, 1, 2}, new[] {3, 4, 5}, new[] {6, 7, 8},// Horizontales
             new[] {0, 3, 6}, new[] {1, 4, 7}, new[] {2, 5, 8},// Verticales
             new[] {0, 4, 8}, new[] {2, 4, 6}// Diagonales
        };

        foreach (var line in winningLines)
        {
            var (a, b, c) = (line[0], line[1], line[2]);
            if (board[a].HasValue && board[a] == board[b] && board[a] == board[c])
            {
                return board[a];
            }
        }

        return null; 
    }
    public async Task RestartGame()
    {
        var partida = (await partidaApiService.GetPartidaAsync(PartidaId)).Data;
        int jugador1Id = partida.Jugador1Id;
        int? jugador2Id = partida.Jugador2Id;

        var creado = await partidaApiService.PostPartida(jugador1Id, jugador2Id);
        if (creado is Resource<PartidaResponse>.Success ok)
        {
            navigationManager.NavigateTo($"/game/{ok.Data.PartidaId}");
        }
        else if (creado is Resource<PartidaResponse>.Error error)
        {
            Console.WriteLine($"Error al iniciar el juego: {error.Message}");
        }
    }

    private string GetPlayerClass(PlayerType? player)
    {
        if (!player.HasValue) return "";
        return player == PlayerType.X ? "player-x" : "player-o";
    }

}